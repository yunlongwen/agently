# Agently Configuration

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096

# Google Gemini (Optional)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# Logging Configuration
AGENTLY_LOG_LEVEL=INFO
AGENTLY_LOG_FORMAT=json

# Performance Constraints
AGENTLY_MAX_MEMORY_MB=4096
AGENTLY_MAX_CONCURRENT_SESSIONS=5
AGENTLY_TIMEOUT_SIMPLE=30
AGENTLY_TIMEOUT_MEDIUM=60
AGENTLY_TIMEOUT_COMPLEX=120

# Paths
# AGENTLY_PROJECT_ROOT=/path/to/project
# AGENTLY_CONFIG_DIR=/path/to/config
# AGENTLY_CACHE_DIR=/path/to/cache
